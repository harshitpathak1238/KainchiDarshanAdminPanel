Options -Indexes
RewriteEngine On

# Keep secrets, schema, logs, and private storage out of the web root.
<FilesMatch "^(config\.php|config\.example\.php|database\.sql|\.env|.*\.log)$">
  Require all denied
</FilesMatch>
RewriteRule ^(private|storage/private)(/|$) - [F,L]

# This project is deployed into the existing website's /admin directory.
# These rules are relative to /admin, so the frontend at the site root is untouched.
RewriteRule ^assets/(.*)$ public/assets/$1 [L]
RewriteRule ^api/(.*)$ api/index.php [QSA,L]
RewriteRule ^$ index.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
